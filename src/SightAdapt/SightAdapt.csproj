<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SightAdapt</AssemblyName>
    <RootNamespace>SightAdapt</RootNamespace>
    <Product>SightAdapt</Product>
    <Title>SightAdapt</Title>
    <Description>Free, open-source per-application visual accessibility and color correction for Windows.</Description>
    <Company>KeyffMS / aiteracja.pl</Company>
    <Authors>$(Company)</Authors>
    <Copyright>Copyright © $(Company)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/KeyffMS/SightAdapt</RepositoryUrl>
    <ProductWebsiteUrl>https://aiteracja.pl/sightadapt/</ProductWebsiteUrl>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>$(SightAdaptRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SightAdaptBundleManifestDirectory>$(MSBuildProjectDirectory)\..\..\artifacts</SightAdaptBundleManifestDirectory>
    <SightAdaptBundleManifestPath>$(SightAdaptBundleManifestDirectory)\dotnet-files-to-bundle.tsv</SightAdaptBundleManifestPath>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="License" Value="MIT License" />
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
    <AssemblyMetadata Include="WebsiteUrl" Value="$(ProductWebsiteUrl)" />
    <AssemblyMetadata Include="Milestone" Value="$(SightAdaptMilestone)" />
    <AssemblyMetadata Include="SettingsSchema" Value="$(SightAdaptSettingsSchema)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE"
          Link="LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt"
          Link="THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\DOTNET-LICENSE-NOTICE.txt"
          Link="DOTNET-LICENSE-NOTICE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NAMES-AND-DRM-NOTICE.txt"
          Link="THIRD-PARTY-NAMES-AND-DRM-NOTICE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\DEPENDENCIES.md"
          Link="DEPENDENCIES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\PRIVACY.md"
          Link="PRIVACY.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CaptureSightAdaptFilesToBundle"
          BeforeTargets="GenerateSingleFileBundle"
          DependsOnTargets="PrepareForBundle"
          Condition="'$(PublishSingleFile)' == 'true' and '$(SelfContained)' == 'true'">
    <MakeDir Directories="$(SightAdaptBundleManifestDirectory)" />
    <WriteLinesToFile File="$(SightAdaptBundleManifestPath)"
                      Lines="@(FilesToBundle->'%(FullPath)|%(RelativePath)|%(BundleRelativePath)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="UTF-8" />
  </Target>
</Project>
